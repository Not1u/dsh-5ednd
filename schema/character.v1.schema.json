{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dnd5e.character.v1",
  "title": "D&D 5e (SRD) Player Character",
  "type": "object",
  "required": ["schema", "id", "name", "player", "level", "race", "classes", "background", "abilities", "hp", "meta"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "dnd5e.character.v1" },
    "id": { "type": "string" },
    "name": { "type": "string" },
    "player": { "type": "string" },
    "level": { "type": "integer", "minimum": 1, "maximum": 20 },
    "xp": { "type": "integer", "minimum": 0 },
    "alignment": { "type": ["string", "null"] },
    "race": { "type": "string", "description": "key in rules races, e.g. dwarf/mountain" },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "level"],
        "additionalProperties": false,
        "properties": {
          "class": { "type": "string" },
          "level": { "type": "integer", "minimum": 1, "maximum": 20 }
        }
      }
    },
    "background": { "type": "string" },
    "abilities": {
      "description": "final ability scores AFTER racial ASI",
      "type": "object",
      "required": ["str", "dex", "con", "int", "wis", "cha"],
      "additionalProperties": false,
      "properties": {
        "str": { "type": "integer", "minimum": 1, "maximum": 30 },
        "dex": { "type": "integer", "minimum": 1, "maximum": 30 },
        "con": { "type": "integer", "minimum": 1, "maximum": 30 },
        "int": { "type": "integer", "minimum": 1, "maximum": 30 },
        "wis": { "type": "integer", "minimum": 1, "maximum": 30 },
        "cha": { "type": "integer", "minimum": 1, "maximum": 30 }
      }
    },
    "abilityMethod": { "type": "string", "enum": ["standard-array", "point-buy", "rolled"] },
    "savingThrowProfs": { "type": "array", "items": { "type": "string", "enum": ["str", "dex", "con", "int", "wis", "cha"] } },
    "skillProfs": { "type": "array", "items": { "type": "string" } },
    "skillExpertise": { "type": "array", "items": { "type": "string" } },
    "armor": { "type": ["object", "null"], "additionalProperties": true, "description": "{ key, shield?: boolean } — AC derived by engine" },
    "weapons": { "type": "array", "items": { "type": "string" }, "description": "weapon keys carried (engine derives attack from best fit)" },
    "otherProfs": { "type": "array", "items": { "type": "string" }, "description": "tool/language/vehicle profs etc." },
    "features": {
      "type": "object",
      "additionalProperties": true,
      "description": "resolved feature keys per source: { race: [...], class: [...], background: [...] }"
    },
    "spellcasting": { "type": ["object", "null"], "additionalProperties": true, "description": "Phase-1 not seeded; reserve for casters" },
    "hp": {
      "type": "object",
      "required": ["current", "max", "temp", "hitDiceTotal", "hitDiceUsed"],
      "additionalProperties": false,
      "properties": {
        "current": { "type": "integer" },
        "max": { "type": "integer" },
        "temp": { "type": "integer" },
        "hitDiceTotal": { "type": "string", "description": "e.g. 1d10" },
        "hitDiceUsed": { "type": "integer" }
      }
    },
    "resources": { "type": "object", "additionalProperties": true, "description": "per-class/racial recoverable resources (rage, second wind…) by key with current/used" },
    "inventory": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "currency": { "type": "object", "additionalProperties": true },
    "conditions": { "type": "array", "items": { "type": "string" } },
    "inspiration": { "type": "boolean" },
    "notes": { "type": "string" },
    "meta": {
      "type": "object",
      "required": ["schemaVersion", "campaign", "createdAt", "updatedAt"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "type": "string" },
        "campaign": { "type": ["string", "null"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    }
  }
}
