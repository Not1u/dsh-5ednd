{
  "name": "dsh-5ednd",
  "version": "0.1.0",
  "private": true,
  "description": "DSH profile plugin: D&D 5e character sheets (sidebar tab), rules engine and rulebook finder.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": { "node": ">=20" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [ "dsh-better-sidebar" ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "files": [ "lib/index.js", "lib/client.js", "cordis.patch.yml", "README.md" ]
}